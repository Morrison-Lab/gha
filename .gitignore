.claude/worktrees/
.DS_Store
*.Rproj.user
.Rhistory
__pycache__/

# gemini-cli settings and credentials
.gemini/
gha-creds-*.json

# Quarto intermediates anywhere in the tree. Per-project build outputs
# (website/_site/, website/.quarto/) are ignored by each project's own .gitignore.
**/*.quarto_ipynb

node_modules/
ard-*.md

# opencode-code-review runtime artifacts (gha#707); overwritten per review run,
# never source files -- a local run must not re-commit them.
review-error.log
review-output.md

# restore-default-branch-workflows runtime marker (gha#598, gha#765)
.github/workflows/.restored-from-default-branch
