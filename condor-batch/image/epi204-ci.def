Bootstrap: localimage
From: lds-ci.sif

# epi204 render image for condor-batch (gha#1638): lds-ci.sif plus epi204's
# renv library, restored from its renv.lock into a system library inside the
# image, and the epi204 package itself installed from the repository at the
# build commit. A render copies only its working directory in and the output
# paths out, so the library has to live in the image; restoring it into the
# cluster home would break WWU CS IT rule 4 (the home quota is 5 GB).
#
# Build with condor-batch/image/build-epi204-ci.sh, which checks out epi204 at a
# ref and passes this recipe the lockfile and a source tarball of the package.
# Build on cf463-02 with Apptainer, next to lds-ci.sif.
#
# renv's autoloader is turned off at run time: epi204's .Rprofile sources
# renv/activate.R, which would otherwise look for a project library that the
# job's working directory does not hold and try to bootstrap renv from the
# network.

%files
    renv.lock /opt/epi204/renv.lock
    epi204.tar.gz /opt/epi204/epi204.tar.gz
    gh-pat /tmp/gh-pat

%environment
    export R_LIBS_SITE=/opt/epi204-library
    export RENV_CONFIG_AUTOLOADER_ENABLED=FALSE

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    # System libraries the lockfile's source builds commonly compile against.
    apt-get update
    apt-get install -y --no-install-recommends \
        libnlopt-dev libudunits2-dev libgdal-dev libgeos-dev libproj-dev \
        libmagick++-dev libpoppler-cpp-dev libhdf5-dev libnode-dev

    # Credentials for the lockfile's git source (rme). The build script writes
    # GITHUB_PAT from its environment into gh-pat (empty when unset), and the
    # file is removed below, so the token is not in the finished image.
    # Tracing is off around the read, so set -x does not print the token.
    set +x
    if [ -s /tmp/gh-pat ]; then export GITHUB_PAT="$(cat /tmp/gh-pat)"; fi
    set -x
    mkdir -p /opt/epi204-library
    export R_LIBS_SITE=/opt/epi204-library
    export R_REPO="https://packagemanager.posit.co/cran/__linux__/noble/latest"
    export RENV_CONFIG_AUTOLOADER_ENABLED=FALSE
    # The lockfile's R version is 4.6.0 (renv.lock, "R" > "Version") and the
    # lds-ci.sif base carries R 4.5 (lds-ci.def), so
    # renv warns about the version and restores the locked package versions.
    Rscript -e 'options(repos = c(CRAN = Sys.getenv("R_REPO")), Ncpus = 4L, HTTPUserAgent = sprintf("R/%s R (%s)", getRversion(), paste(getRversion(), R.version$platform, R.version$arch, R.version$os))); install.packages("renv"); renv::restore(lockfile = "/opt/epi204/renv.lock", library = "/opt/epi204-library", prompt = FALSE)'
    R CMD INSTALL --library=/opt/epi204-library /opt/epi204/epi204.tar.gz
    rm /opt/epi204/epi204.tar.gz
    rm -f /tmp/gh-pat
    chmod -R a+rX /opt/epi204-library /opt/epi204

    # LaTeX packages epi204's PDF renders need (gha#1660). Quarto installs a missing
    # package with tlmgr at render time, but /opt/TinyTeX is read-only in a job, so
    # bake them here, where it is writable. koma-script (scrartcl.cls), nameref and
    # xpatch are the ones Quarto installed while rendering Midterm1, hw1, hw3,
    # midterm_2 and final_exam in both the assign and solution profiles; luacolor,
    # lua-ul and luatexbase are the tagged-PDF packages lds-ci.sif already carries,
    # listed so this image does not depend on the base having them.
    /opt/TinyTeX/bin/x86_64-linux/tlmgr option repository https://tlnet.yihui.org
    /opt/TinyTeX/bin/x86_64-linux/tlmgr install koma-script nameref xpatch luacolor lua-ul luatexbase
    chmod -R a+rX /opt/TinyTeX

%test
    set -e
    export R_LIBS_SITE=/opt/epi204-library
    Rscript -e 'library(epi204); library(gtsummary); library(survival)'
    for f in scrartcl.cls nameref.sty xpatch.sty luacolor.sty lua-ul.sty luatexbase.sty; do test -n "$(kpsewhich "$f")"; done
    Rscript -e 'stopifnot(nrow(installed.packages(lib.loc = "/opt/epi204-library")) > 300)'
